# Токен от @BotFather
BOT_TOKEN=

# --- SQLite ---
# На bothost файл БД обязан лежать в /app/data: только эта папка переживает
# перезапуск контейнера и деплой из Git (и её нельзя коммитить в репозиторий).
# Если переменная не задана, бот сам подставит /app/data/bot.db на хосте
# и bot.db в текущей папке при локальном запуске.
# Хостинг понимает любое из имён: DATABASE_PATH / DB_PATH (бот читает оба).
DATABASE_PATH=/app/data/bot.db

# --- Postgres ---
# Своего Postgres на bothost нет, нужен внешний сервер.
# postgresql://user:password@host:5432/dbname
DATABASE_URL=
